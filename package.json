{
  "name": "just-bash-monorepo",
  "private": true,
  "description": "Monorepo root for just-bash",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun --filter @demicodes/just-bash build && bun --filter @just-bash/executor build",
    "build:worker": "bun --filter @demicodes/just-bash build:worker",
    "typecheck": "bun --filter @demicodes/just-bash build && bun --filter @demicodes/just-bash typecheck && bun --filter @just-bash/executor typecheck",
    "lint": "biome check . && bun --filter @demicodes/just-bash lint:banned",
    "lint:fix": "biome check --write .",
    "knip": "bun --filter @demicodes/just-bash knip",
    "test:run": "bun --filter @demicodes/just-bash test:run && bun --filter @just-bash/executor test:run",
    "test:unit": "bun --filter @demicodes/just-bash test:unit && bun --filter @just-bash/executor test:unit",
    "test:wasm": "bun --filter @demicodes/just-bash test:wasm",
    "test:comparison": "bun --filter @demicodes/just-bash test:comparison",
    "test:comparison:record": "bun --filter @demicodes/just-bash test:comparison:record",
    "test:dist": "bun --filter @demicodes/just-bash test:dist",
    "test:examples": "bun --filter cjs-consumer-example typecheck",
    "check:worker-sync": "bun --filter @demicodes/just-bash check:worker-sync",
    "shell": "bun --filter @demicodes/just-bash shell",
    "dev:exec": "bun --filter @demicodes/just-bash dev:exec",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "vite": "8.0.10"
  },
  "trustedDependencies": [
    "@mongodb-js/zstd",
    "esbuild",
    "node-liblzma",
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.14"
}
